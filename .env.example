# =========================================================
# Configuracao do bot do WhatsApp
# Copie este arquivo para .env e edite com os valores reais.
# Nenhum valor real mora neste repositorio: endereco, numero e nomes de
# grupo abaixo sao marcadores.
# =========================================================

# Endereco da rota de captura do app (a base das outras rotas sai daqui)
LIS_CAPTURE_URL=https://SEU-DOMINIO/api/whatsapp/capture

# Segredo de autenticacao (Bearer). E o mesmo valor da variavel
# CAPTURE_WA_SECRET do app.
LIS_CAPTURE_SECRET=COLOQUE_AQUI

# Grupos da casa que o bot escuta.
# O JID e o que vale: WA_GROUP_JIDS, separados por virgula ou ponto e virgula
# (formato 120363000000000000@g.us). Quando definido, o nome e ignorado.
# Sem JIDs, o bot procura os grupos por WA_GROUP_NAMES (separados por ponto e
# virgula) UMA vez, grava o JID achado em estado/grupos-da-casa.json e dali
# em diante renomear o grupo nao muda nada. Dois grupos com o mesmo nome: o
# bot nao adota nenhum e avisa no log.
# Os grupos de escritorios clientes nao entram aqui: vem do app.
WA_GROUP_JIDS=
WA_GROUP_NAMES=Nome do grupo 1;Nome do grupo 2

# OPCIONAL: numero do chip do bot, formato internacional sem +, espaco ou
# traco. Se definido, o bot usa pareamento por CODIGO de 8 digitos em vez de
# QR. Exemplo ficticio: 5500900000000
WA_PHONE_NUMBER=

# Pastas (a sessao do WhatsApp e o estado local; ambas ficam so com o dono)
WA_AUTH_DIR=./auth_state
WA_ESTADO_DIR=./estado

# Nivel de log do pino (debug | info | warn | error). O log nunca leva nome
# nem texto de mensagem, em nenhum nivel.
LOG_LEVEL=info

# Identidade deste chip no estoque do app (uuid de wa_numero). Com ele o bot
# atende varios escritorios: busca a fila de pedidos e a tabela de
# roteamento grupo -> organizacao.
WA_NUMERO_ID=

# Mandar o numero do chip no heartbeat, nos eventos, no aviso de queda e na
# busca da fila de saida. Deixe 0 ate o app novo estar no ar (o vigia e a fila
# de saida precisam ler a linha do chip). Ver o registro do lote BOTS.
WA_ENVIAR_NUMERO_ID=0

# Aviso de privacidade na mensagem de entrada em grupo de escritorio.
# Fica desligado ate a politica de privacidade estar publicada. Para ligar,
# informe o endereco https da politica; ligado sem endereco valido nao liga.
WA_AVISO_ENTRADA=desligado
WA_URL_PRIVACIDADE=

# Arquivo recebido do grupo: teto em MB (o app recebe ate cerca de 4,5 MB por
# requisicao e o base64 cresce um terco). Acima disso o bot avisa no grupo.
WA_LIMITE_ARQUIVO_MB=3

# Mensagem de visualizacao unica: ignorar (padrao) ou capturar.
WA_VISUALIZACAO_UNICA=ignorar

# Enviar ao app a mensagem editada (so ligar quando a rota de captura tratar
# o campo wa_edita_message_id; ligada antes disso, a edicao vira tarefa nova).
WA_ENVIAR_EDICOES=0

# Hosts extras de onde a figurinha pode ser baixada, alem de *.supabase.co
WA_STICKER_HOSTS=

# Tempos e tetos (os valores abaixo ja sao os padroes)
LIS_TIMEOUT_S=280
WA_PEDIDOS_INTERVALO_S=15
WA_FILA_MAX_ITENS=500
WA_FILA_MAX_MB=64
WA_FILA_ENTRADA_HORAS=24
WA_FILA_SAIDA_HORAS=6
WA_SAIDA_POR_MINUTO=10
WA_SAIDA_POR_HORA=100
